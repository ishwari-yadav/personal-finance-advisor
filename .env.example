# ------------------------------------------------------------------
# Personal Finance Advisor Bot - example environment file
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file or a real API key to Git.
# ------------------------------------------------------------------

# Gemini AI configuration (get a free key at https://aistudio.google.com/)
# Keys come in two formats - the classic "AIza..." and the newer "AQ....";
# both work, just paste the whole key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Models tried (in order) when the primary model is overloaded
# ("experiencing high demand"). Set to empty to disable fallbacks.
# Run "python list_models.py" to see which models your key can access.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash-lite

# Flask configuration
FLASK_ENV=development
SECRET_KEY=
